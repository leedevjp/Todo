NEXT_PUBLIC_SUPABASE_URL=https://ypvccilmhzqexuafcven.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key

# Server only: Supabase Connect > Transaction pooler (6543).
# Replace the password with your URL-encoded database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt
# Prisma migrations: Supabase Connect > Session pooler (5432).
DIRECT_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt
